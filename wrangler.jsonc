{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bielinvest",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "routes": [
    { "pattern": "bielinvest.com", "custom_domain": true },
    { "pattern": "www.bielinvest.com", "custom_domain": true }
  ],
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "bielinvest"
    }
  ]
}
